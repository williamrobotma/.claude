{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(conda env list)",
      "Bash(conda activate *)",
      "Bash(mamba activate *)",
      "Bash(source \"$(conda info --base)/etc/profile.d/conda.sh\"*)",
      "Bash(parallel --version)",
      "Bash(tmux -V)",
      "Bash(cat ~/.claude/settings.json 2>/dev/null | head -30)",
      "Read(//home/wma/.claude/**)",
      "Bash(gh auth *)",
      "Bash(pylint *)",

      "Bash(git push --dry-run*)",
      "Bash(git push -n *)",
      "Bash(git add --dry-run*)",
      "Bash(git add -n *)",
      "Bash(git clean -n *)",
      "Bash(git clean --dry-run*)",
      "Bash(git fetch --dry-run*)",
      "Bash(git pull --dry-run*)",
      "Bash(bash -n *)",

      "Bash(conda info*)",
      "Bash(conda list*)",
      "Bash(conda search *)",
      "Bash(conda config --show*)",
      "Bash(conda install --dry-run *)",
      "Bash(conda env update --dry-run *)",
      "Bash(mamba info*)",
      "Bash(mamba list*)",
      "Bash(mamba search *)",
      "Bash(pip check)",
      "Bash(pip freeze*)",
      "Bash(pip install --dry-run *)",

      "Bash(tmux list-sessions*)",
      "Bash(tmux ls *)",
      "Bash(tmux list-windows*)",
      "Bash(tmux list-panes*)",
      "Bash(curl -I *)",
      "Bash(curl --head *)",
      "Bash(curl --version)",
      "Bash(pytest --version)",
      "Bash(pytest --collect-only *)",
      "Bash(pytest --co *)",
      "Bash(make -n *)",
      "Bash(make --dry-run *)",
      "Bash(make --question *)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/home/wma/.claude"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "outputStyle": "default",
  "effortLevel": "xhigh",
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "autoCompactEnabled": true
}
