{
  "skillListingBudgetFraction": 0.015,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:bm2-lab.github.io)",
      "WebFetch(domain:www.nature.com)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:hyper.ai)",
      "Bash(conda env list)",
      "Bash(conda activate *)",
      "Bash(mamba activate *)",
      "Bash(source \"$(conda info --base)/etc/profile.d/conda.sh\"*)",
      "Bash(source $(conda info --base)/etc/profile.d/conda.sh*)",
      "Bash(parallel --version)",
      "Bash(tmux -V)",
      "Read(//home/wma/.claude/**)",
      "Bash(gh auth status)",
      "Bash(gh browse * --no-browser)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh repo view *)",
      "Bash(gh search *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh status)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh label list *)",
      "Bash(pylint *)",
      "Bash(git push --dry-run*)",
      "Bash(git push -n *)",
      "Bash(git clean -n *)",
      "Bash(git clean --dry-run*)",
      "Bash(git pull --dry-run*)",
      "Bash(bash -n *)",
      "Bash(conda info*)",
      "Bash(conda list*)",
      "Bash(conda search *)",
      "Bash(conda config --show*)",
      "Bash(conda install --dry-run *)",
      "Bash(conda env update --dry-run *)",
      "Bash(mamba info*)",
      "Bash(mamba list*)",
      "Bash(mamba search *)",
      "Bash(mamba env list *)",
      "Bash(pip check)",
      "Bash(pip freeze*)",
      "Bash(pip list*)",
      "Bash(pip install --dry-run *)",
      "Bash(pip show *)",
      "Bash(tmux list-sessions*)",
      "Bash(tmux ls *)",
      "Bash(tmux list-windows*)",
      "Bash(tmux list-panes*)",
      "Bash(curl -I *)",
      "Bash(curl --head *)",
      "Bash(curl --version)",
      "Bash(pytest --version)",
      "Bash(pytest --collect-only *)",
      "Bash(pytest --co *)",
      "Bash(make -n *)",
      "Bash(make --dry-run *)",
      "Bash(make --question *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git merge-base *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git remote get-url *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Bash(git submodule status*)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ruff *)",
      "Bash(command -v *)",
      "Bash(command -V *)",
      "Bash(ps *)",
      "Bash(top *)",
      "Bash(free *)",
      "Bash(dmesg *)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-smi *)",
      "Bash(pgrep *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(stat *)",
      "Bash(readlink *)",
      "Bash(wc *)",
      "Bash(claude list-sessions *)",
      "Bash(claude mcp list*)",
      "Bash(claude mcp get *)",
      "Bash(git check-ignore *)",
      "Bash(bash ~/.claude/sync.sh save)",
      "Bash(bash ~/.claude/sync.sh push)",
      "Skill(hookify:hookify)",
      "Skill(hookify:hookify:*)"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/id_*)",
      "Read(~/.env)",
      "Read(./**/.env)",
      "Bash(rm * /)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/awk-guard.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/sync.sh save"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "consensus@life-sciences": true,
    "pubmed@life-sciences": true,
    "scvi-tools@life-sciences": true,
    "single-cell-rna-qc@life-sciences": true
  },
  "extraKnownMarketplaces": {
    "life-sciences": {
      "source": {
        "source": "github",
        "repo": "anthropics/life-sciences"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "autoCompactEnabled": false,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
