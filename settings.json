    "deny": [
      "Read(//home/wma/.claude/.credentials.json)",
      "Read(//home/wma/.claude/settings.local.json)",
      "Read(//home/wma/.claude/history.jsonl)",
      "Read(//home/wma/.ssh/id_*)",
      "Read(./**/settings.local.json)",
      "Read(./**/.env)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/sync.sh pull" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/sync.sh save" } ] }
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "/home/wma/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "autoCompactEnabled": false,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
