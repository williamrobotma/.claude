#!/usr/bin/env bash
# claude-local: Claude Code on the local llama-server router - one lane per session, plugins off.
# Synced to all machines; a per-machine shim invokes it. Canonical spec:
# williamrobotma/ollama-modelfiles AGENTS.md#claude-local (feat/llamacpp-migration).
set -u

router=http://127.0.0.1:11433
last_file=$HOME/.config/claude-local.last
last=$(cat "$last_file" 2>/dev/null)

# --settings is a per-session CLI override (beats settings.json); built before the menu so a broken
# settings.json fails before a lane gets picked.
no_plugins="$(python3 - <<'EOF'
import json
import os

path = os.path.expanduser("~/.claude/settings.json")
with open(path, encoding="utf-8") as f:
    plugins = json.load(f).get("enabledPlugins", {})
print(json.dumps({"enabledPlugins": {name: False for name in plugins}}))
EOF
)" || { echo "claude-local: could not build the plugin-disable override from ~/.claude/settings.json" >&2; exit 1; }

body=$(curl -fsS -m 5 "$router/v1/models") \
    || { echo "claude-local: no model list from $router/v1/models - is the router up?" >&2; exit 1; }
# Tab carrier: name<TAB>display. Ids are models.ini section names, so they are tab-free.
raw=$(CL_BODY=$body python3 - <<'EOF'
import json
import os

for m in json.loads(os.environ["CL_BODY"])["data"]:
    status = m["status"]["value"]
    print(m["id"] + "\t" + status)
    for alias in m["aliases"]:
        print(alias + "\t" + status + "  (alias -> " + m["id"] + ")")
EOF
) || { echo "claude-local: could not parse the $router/v1/models response" >&2; exit 1; }
[ -n "$raw" ] || { echo "claude-local: $router/v1/models returned an empty fleet" >&2; exit 1; }
mapfile -t lanes < <(LC_ALL=C sort <<<"$raw")

pick=
if [ -t 0 ]; then
    i=0
    for entry in "${lanes[@]}"; do
        i=$((i+1))
        id=${entry%%$'\t'*}; display=${entry#*$'\t'}
        mark=''; [ "$id" = "$last" ] && mark='  <- last'
        printf '%3d) %-40s %s%s\n' "$i" "$id" "$display" "$mark" >&2
    done
    read -r -p "lane [${last:-none}]: " pick || { echo "claude-local: aborted" >&2; exit 1; }
elif [ -n "$last" ]; then
    echo "claude-local: non-interactive, reusing lane $last" >&2
else
    echo "claude-local: non-interactive and no saved lane; the fleet:" >&2
    printf '  %s\n' "${lanes[@]%%$'\t'*}" >&2
    exit 1
fi
# A menu pick is digits only. Everything else is a lane name verbatim (escape hatch; the router 404s
# on a typo) - including 0*: bash's ${lanes[-1]} would make a bare 0 silently pick the last lane.
case $pick in
    '')          model=$last ;;
    *[!0-9]*|0*) model=$pick ;;
    *)           model=${lanes[$pick-1]-}; model=${model%%$'\t'*} ;;
esac
if [ -z "$model" ]; then
    echo "claude-local: no valid lane picked; the fleet:" >&2
    printf '  %s\n' "${lanes[@]%%$'\t'*}" >&2
    exit 1
fi
# Off-fleet picks (typos) are not persisted.
case " ${lanes[*]%%$'\t'*} " in
    *" $model "*)
        mkdir -p "$HOME/.config"
        printf '%s\n' "$model" > "$last_file" ;;
esac

export ANTHROPIC_BASE_URL=$router
export ANTHROPIC_AUTH_TOKEN=local-router-dummy
# ANTHROPIC_MODEL pins the main model; settings.json's model otherwise reaches the wire verbatim.
export ANTHROPIC_MODEL=$model
export ANTHROPIC_DEFAULT_HAIKU_MODEL=$model
export ANTHROPIC_DEFAULT_SONNET_MODEL=$model
export ANTHROPIC_DEFAULT_OPUS_MODEL=$model
export CLAUDE_CODE_SUBAGENT_MODEL=$model

# Web-search MCP wiring, gated on its config existing (present on WSL only).
# =VALUE form is required on the variadic flags: the space form eats "$@".
mcp_config=$HOME/.config/claude-local.mcp.json
if [ -f "$mcp_config" ]; then
    set -a
    # shellcheck source=/dev/null
    source "$HOME/.config/claude-local.env" \
        || { echo "claude-local: failed to load ~/.config/claude-local.env (required with $mcp_config)" >&2; exit 1; }
    set +a
    exec claude --settings="$no_plugins" --disallowedTools=WebSearch --mcp-config="$mcp_config" "$@"
fi
exec claude --settings="$no_plugins" "$@"
